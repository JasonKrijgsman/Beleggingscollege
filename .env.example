# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore — zet hier NOOIT echte sleutels in .env.example.

# --- Database (Neon, regio Frankfurt aws-eu-central-1) ---------------------
# De app gebruikt de POOLED string (hostname bevat "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Migraties en pg_dump gebruiken de DIRECTE string (zonder "-pooler").
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Genereer met: npx auth secret
AUTH_SECRET=""

# Google Cloud Console -> Google Auth Platform -> Clients -> Web application.
# Zet METEEN alle vier de redirect-URI's erin, ook die van de .nl. Google staat
# er meerdere toe, en dan hoeft er bij de domeinverhuizing niets meer te wijzigen:
#   http://localhost:3000/api/auth/callback/google
#   https://beleggingscollege.com/api/auth/callback/google
#   https://beleggingscollege.nl/api/auth/callback/google
#   https://www.beleggingscollege.nl/api/auth/callback/google
# Alleen de scopes openid, email en profile: dan is Google's volledige
# verificatietraject niet nodig.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Site -----------------------------------------------------------------
# Nu de .com; zodra de .nl verhuisd is hier de .nl invullen.
NEXT_PUBLIC_SITE_URL="https://beleggingscollege.com"

# --- Mollie (later, voor de checkout) -------------------------------------
# Live-key pas invullen als er echt verkocht wordt; test_ voor ontwikkeling.
MOLLIE_API_KEY=""
