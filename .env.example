# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore — zet hier NOOIT echte sleutels in .env.example.

# --- Database (Neon, regio Frankfurt aws-eu-central-1) ---------------------
# De app gebruikt de POOLED string (hostname bevat "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Migraties en pg_dump gebruiken de DIRECTE string (zonder "-pooler").
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Genereer met: npx auth secret
AUTH_SECRET=""

# Google Cloud Console -> Google Auth Platform -> Clients -> Web application.
# Zet METEEN alle vier de redirect-URI's erin, ook die van de .nl. Google staat
# er meerdere toe, en dan hoeft er bij de domeinverhuizing niets meer te wijzigen:
#   http://localhost:3000/api/auth/callback/google
#   https://beleggingscollege.com/api/auth/callback/google
#   https://beleggingscollege.nl/api/auth/callback/google
#   https://www.beleggingscollege.nl/api/auth/callback/google
# Alleen de scopes openid, email en profile: dan is Google's volledige
# verificatietraject niet nodig.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Site -----------------------------------------------------------------
# Nu de .com; zodra de .nl verhuisd is hier de .nl invullen.
NEXT_PUBLIC_SITE_URL="https://beleggingscollege.com"

# --- Mollie (checkout) ----------------------------------------------------
# Live-key pas invullen als er echt verkocht wordt; test_ voor ontwikkeling.
MOLLIE_API_KEY=""

# --- E-mail (orderbevestiging via Migadu SMTP) ----------------------------
# LET OP: eerst Migadu's DNS-records zetten, dan pas invullen. Anders weigeren
# ontvangers elke mail (DMARC staat op reject; zonder Migadu's DKIM en SPF
# slaagt geen van beide). Records: docs/migadu-records.txt.
# Bij Migadu is de gebruikersnaam het volledige mailadres.
MAIL_SMTP_GEBRUIKER=""
MAIL_SMTP_WACHTWOORD=""
# Host en poort hebben werkende standaarden (smtp.migadu.com, 465). Laat ze
# uitgecommentarieerd staan tenzij je ergens anders heen wilt — een lege waarde
# is iets anders dan een ontbrekende waarde, en leeg invullen zou de standaard
# juist overschrijven.
# MAIL_SMTP_HOST=""
# MAIL_SMTP_PORT=""
MAIL_AFZENDER="Beleggingscollege <beheer@beleggingscollege.nl>"

# --- Bedrijfsgegevens in de orderbevestiging ------------------------------
# Deze staan bewust in omgevingsvariabelen en NIET in de code: Jason wil zijn
# woonadres niet in een publieke repo. Vestigingsadres als één regel, bijv.
# "Straatnaam 1, 1234 AB Den Haag". Btw-nummer als NL123456789B01.
BEDRIJF_ADRES=""
BEDRIJF_BTW_NUMMER=""

# --- Beheer ---------------------------------------------------------------
# Kommagescheiden e-mailadressen die /beheer mogen zien (overzicht van
# klanten en aankopen, én de vragenmoderatie). Ontbreekt de variabele, dan
# is niemand beheerder. De oudere naam BEHEER_EMAILS werkt nog als terugval.
ADMIN_EMAILS=""

# --- Bezoekmeting (Umami, zelf gehost) ------------------------------------
# Allebei leeg laten = geen meting. Er wordt dan geen script geladen en er
# gaat geen enkel verzoek uit, zodat deze code veilig in main staat voordat de
# Umami-instantie bestaat. Lokaal bewust NIET invullen: anders meet je jezelf.
#
# Umami draait als eigen Vercel-project met een eigen Neon-database; de
# opzetstappen staan in docs/analytics.md. Beide waarden zijn openbaar — ze
# staan in de browserbundel — en dus géén geheim. De website-id is een
# verwijzing, geen sleutel.
NEXT_PUBLIC_UMAMI_URL="https://stats.beleggingscollege.com"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
